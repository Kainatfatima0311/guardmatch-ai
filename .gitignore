# ---------------------------------------------------------------------------
# Internal working files — deliberately not published
# ---------------------------------------------------------------------------
# PLAN.md and PROGRESS.md track how the work is being carried out. They are not
# deliverables. The design doc and every file under docs/ ARE deliverables and
# are committed.
PLAN.md
PROGRESS.md

# ---------------------------------------------------------------------------
# Generated data
# ---------------------------------------------------------------------------
# Everything under backend/data/ is reproducible from a seed via
# `guardmatch generate-data`, so committing it would add weight without adding
# information. Model artifacts under backend/models/ are NOT ignored — versioned
# artifacts are a project deliverable.
#
# The leading slash anchors this to the repository root. Without it, the pattern
# would also match backend/src/guardmatch/data/ — the synthetic data generator
# package — and silently exclude source code from every commit. That is not
# hypothetical: it happened once and was fixed in commit efff6ce.
/backend/data/
*.parquet
*.feather

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.local
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environments
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Testing and type checking
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
notebooks/*.ipynb

# ---------------------------------------------------------------------------
# Node and Next.js
# ---------------------------------------------------------------------------
# Lockfiles are NOT ignored. `npm ci` in CI needs package-lock.json, and a
# reproducible frontend build is the same argument as a seeded dataset.
node_modules/
.next/
out/
next-env.d.ts
.turbo/
*.tsbuildinfo
.vercel/
npm-debug.log*
yarn-error.log*

# Vitest coverage output, mirroring the Python side.
/frontend/coverage/

# Local overrides only. .env.example stays committed as documentation.
.env*.local

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
