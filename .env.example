# GuardMatch AI — example configuration
#
# Copy to .env and adjust. The .env file is gitignored; this example is not.
# Every value here has a default in src/guardmatch/core/config.py, so the
# service starts with none of them set.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Which versioned artifact directory under models/ to serve.
# Rolling back to a previous model is a change to this value — not a rebuild.
MODEL_VERSION=v0.1.0

# Directory holding versioned model artifacts.
MODEL_DIR=models

# ---------------------------------------------------------------------------
# Fairness
# ---------------------------------------------------------------------------
# Shortlist depth. Every top-k fairness metric is computed at this value, so it
# must match the number of candidates a reviewer actually looks at. Set to 10
# during design review.
FAIRNESS_TOP_K=10

# Four-fifths rule. A group's selection rate must be at least this fraction of
# the highest group's rate. Breaching it fails the build.
ADVERSE_IMPACT_THRESHOLD=0.80

# Maximum permitted gap for demographic parity and equal opportunity.
MAX_FAIRNESS_GAP=0.10

# Groups smaller than this are suppressed from the report rather than published
# as unstable noise.
MIN_GROUP_SIZE=30

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Maximum candidates accepted in a single /rank request. Unbounded batch sizes
# are an availability risk.
MAX_RANK_BATCH=500

# ---------------------------------------------------------------------------
# Data generation
# ---------------------------------------------------------------------------
RANDOM_SEED=42
N_CANDIDATES=5000
N_JOBS=200

# Injects a correlation between a protected attribute and an apparently neutral
# feature. Used to prove the fairness audit actually detects bias. Off by
# default; whatever value was used is recorded in docs/data-card.md.
INJECT_BIAS=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# json for production and container runs; console for readable local output.
LOG_FORMAT=json
